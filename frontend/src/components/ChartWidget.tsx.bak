"use client";

import { useRef, useState } from "react";
import {
  LineChart, Line,
  BarChart, Bar,
  PieChart, Pie, Cell,
  ScatterChart, Scatter, ZAxis,
  RadarChart, Radar, PolarGrid, PolarAngleAxis, PolarRadiusAxis,
  FunnelChart, Funnel, LabelList,
  ComposedChart, Area,
  Treemap,
  XAxis, YAxis, CartesianGrid, Tooltip, Legend,
  ResponsiveContainer,
} from "recharts";
import type { QueryResult, ChartType } from "@/lib/types";

const PALETTE = ["#4f7cff","#9b5de5","#22d3c5","#5ebd8b","#e0707a","#f5b942","#f97316","#06b6d4"];
const TOOLTIP_STYLE = { background: "#161d2e", border: "1px solid rgba(255,255,255,0.1)", borderRadius: 8 };
const LABEL_STYLE = { fill: "#cbd5e1", fontSize: 10, fontWeight: 500 };
const GRID = <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.06)" />;
const H = 260;

// ── helpers ─────────────────────────────────────────────────────────────────

function toRows(result: QueryResult): Record<string, unknown>[] {
  return result.rows.map((row) => {
    const obj: Record<string, unknown> = {};
    result.columns.forEach((col, i) => {
      const v = row[i];
      obj[col] = typeof v === "string" && v !== "" && !isNaN(parseFloat(v)) ? parseFloat(v) : v;
    });
    return obj;
  });
}

function fmt(v: unknown): string | null {
  if (v === null || v === undefined || v === "") return null;
  const n = Number(v);
  if (isNaN(n)) return null;
  if (Math.abs(n) >= 1_000_000) return (n / 1_000_000).toFixed(1) + "M";
  if (Math.abs(n) >= 1_000) return (n / 1_000).toFixed(1) + "k";
  return Number.isInteger(n) ? String(n) : n.toFixed(2);
}

function NumLabel({ value }: { value?: unknown }) {
  const s = fmt(value);
  return s ? <tspan>{s}</tspan> : null;
}

// ── export ───────────────────────────────────────────────────────────────────

function useExport(ref: React.RefObject<HTMLDivElement>) {
  function getSVGElement(): SVGSVGElement | null {
    return ref.current?.querySelector("svg") ?? null;
  }

  function exportSVG(filename = "widget") {
    const svg = getSVGElement();
    if (!svg) return;
    const clone = svg.cloneNode(true) as SVGSVGElement;
    clone.setAttribute("xmlns", "http://www.w3.org/2000/svg");
    const serializer = new XMLSerializer();
    const blob = new Blob([serializer.serializeToString(clone)], { type: "image/svg+xml" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = filename + ".svg";
    a.click();
    URL.revokeObjectURL(a.href);
  }

  function exportPNG(filename = "widget") {
    const el = ref.current;
    if (!el) return;
    const svg = getSVGElement();

    const render = (svgStr: string, w: number, h: number) => {
      const canvas = document.createElement("canvas");
      const scale = 2;
      canvas.width = w * scale;
      canvas.height = h * scale;
      const ctx = canvas.getContext("2d")!;
      ctx.scale(scale, scale);
      ctx.fillStyle = "#0d1117";
      ctx.fillRect(0, 0, w, h);
      const img = new Image();
      const blob = new Blob([svgStr], { type: "image/svg+xml" });
      const url = URL.createObjectURL(blob);
      img.onload = () => {
        ctx.drawImage(img, 0, 0);
        URL.revokeObjectURL(url);
        const a = document.createElement("a");
        a.download = filename + ".png";
        a.href = canvas.toDataURL("image/png");
        a.click();
      };
      img.src = url;
    };

    if (svg) {
      const rect = svg.getBoundingClientRect();
      const clone = svg.cloneNode(true) as SVGSVGElement;
      clone.setAttribute("xmlns", "http://www.w3.org/2000/svg");
      clone.setAttribute("width", String(rect.width));
      clone.setAttribute("height", String(rect.height));
      render(new XMLSerializer().serializeToString(clone), rect.width, rect.height);
    } else {
      // fallback for table/kpi — wrap div content in foreign object
      const rect = el.getBoundingClientRect();
      const svgStr = `<svg xmlns="http://www.w3.org/2000/svg" width="${rect.width}" height="${rect.height}">
        <foreignObject width="100%" height="100%">
          <div xmlns="http://www.w3.org/1999/xhtml" style="background:#0d1117;color:#fff;padding:12px;font-family:sans-serif;font-size:13px">
            ${el.innerHTML}
          </div>
        </foreignObject>
      </svg>`;
      render(svgStr, rect.width, rect.height);
    }
  }

  function exportPDF(filename = "widget") {
    const el = ref.current;
    if (!el) return;
    const svg = getSVGElement();
    const printWindow = window.open("", "_blank");
    if (!printWindow) return;

    let body = "";
    if (svg) {
      const clone = svg.cloneNode(true) as SVGSVGElement;
      clone.setAttribute("xmlns", "http://www.w3.org/2000/svg");
      body = new XMLSerializer().serializeToString(clone);
    } else {
      body = el.innerHTML;
    }

    printWindow.document.write(`<!DOCTYPE html>
<html><head><title>${filename}</title>
<style>
  body { background:#0d1117; color:#fff; font-family:sans-serif; padding:24px; margin:0 }
  svg { max-width:100%; height:auto }
  @media print { body { background:#fff; color:#000 } }
</style></head>
<body>${body}<script>window.onload=()=>{window.print();window.close()}<\/script></body></html>`);
    printWindow.document.close();
  }

  return { exportSVG, exportPNG, exportPDF };
}

// ── export toolbar ────────────────────────────────────────────────────────────

function ExportMenu({ onPNG, onSVG, onPDF }: { onPNG(): void; onSVG(): void; onPDF(): void }) {
  const [open, setOpen] = useState(false);
  return (
    <div className="relative ml-auto">
      <button
        onClick={() => setOpen(o => !o)}
        className="flex items-center gap-1 rounded px-2 py-1 text-xs text-slate-400 hover:bg-white/10 hover:text-white transition"
        title="Export widget"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Export
      </button>
      {open && (
        <div className="absolute right-0 top-full z-50 mt-1 w-28 rounded-lg border border-white/10 bg-base-900 shadow-xl"
          onMouseLeave={() => setOpen(false)}>
          {([["PNG", onPNG], ["SVG", onSVG], ["PDF", onPDF]] as const).map(([label, fn]) => (
            <button key={label}
              onClick={() => { fn(); setOpen(false); }}
              className="block w-full px-3 py-2 text-left text-xs text-slate-300 hover:bg-white/10 hover:text-white first:rounded-t-lg last:rounded-b-lg">
              {label}
            </button>
          ))}
        </div>
      )}
    </div>
  );
}

// ── main component ────────────────────────────────────────────────────────────

export default function ChartWidget({ result, chartType }: { result: QueryResult; chartType: ChartType }) {
  const containerRef = useRef<HTMLDivElement>(null);
  const { exportPNG, exportSVG, exportPDF } = useExport(containerRef);
  const showLabels = result.rows.length <= 30;

  if (!result.rows.length) return <p className="text-sm text-slate-500">No data yet.</p>;

  const data = toRows(result);
  const [xKey, ...restKeys] = result.columns;
  const yKeys = restKeys.length > 0 ? restKeys : [xKey];
  const XA = <XAxis dataKey={xKey} stroke="#8b93a7" fontSize={11} tick={{ fill: "#8b93a7" }} />;
  const YA = <YAxis stroke="#8b93a7" fontSize={11} width={42} tick={{ fill: "#8b93a7" }} tickFormatter={v => fmt(v) ?? String(v)} />;
  const TIP = <Tooltip contentStyle={TOOLTIP_STYLE} formatter={(v: unknown) => [fmt(v) ?? v, ""]} />;

  function wrap(chart: React.ReactNode) {
    return (
      <div className="flex flex-col gap-1">
        <div className="flex justify-end">
          <ExportMenu onPNG={() => exportPNG("widget")} onSVG={() => exportSVG("widget")} onPDF={() => exportPDF("widget")} />
        </div>
        <div ref={containerRef}>{chart}</div>
      </div>
    );
  }

  // ── KPI ──────────────────────────────────────────────────────────────────
  if (chartType === "kpi") {
    let value: number | null = null;
    for (const cell of result.rows[0] ?? []) {
      const n = typeof cell === "number" ? cell : parseFloat(String(cell));
      if (!isNaN(n)) { value = n; break; }
    }
    return wrap(
      <div className="flex items-center justify-center min-h-[120px] p-4 bg-base-800/30 rounded-xl border border-white/10" ref={containerRef}>
        <div className="text-center">
          <div className="text-5xl font-bold text-white">{value !== null ? value.toLocaleString() : "—"}</div>
          <div className="text-xs text-slate-500 mt-1">{xKey}</div>
        </div>
      </div>
    );
  }

  // ── Table ─────────────────────────────────────────────────────────────────
  if (chartType === "table") {
    return wrap(
      <div className="overflow-auto rounded-lg border border-white/5">
        <table className="w-full text-left text-sm">
          <thead>
            <tr className="border-b border-white/10 bg-white/5">
              {result.columns.map(c => <th key={c} className="whitespace-nowrap px-3 py-2 font-medium text-slate-400">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {data.slice(0, 200).map((row, i) => (
              <tr key={i} className="border-b border-white/5 hover:bg-white/5">
                {result.columns.map(c => <td key={c} className="whitespace-nowrap px-3 py-2 text-slate-200">{String(row[c] ?? "")}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
        <div className="px-3 py-2 text-xs text-slate-500">Rows: {result.rows.length}</div>
      </div>
    );
  }

  // ── Pie ───────────────────────────────────────────────────────────────────
  if (chartType === "pie") {
    const vKey = yKeys[0];
    const pieData = data.map(r => ({ ...r, [vKey]: parseFloat(String(r[vKey] ?? 0)) || 0 }));
    const renderLabel = ({ name, percent, value }: { name: string; percent: number; value: number }) =>
      `${name}: ${fmt(value)} (${(percent * 100).toFixed(0)}%)`;
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <PieChart>
          <Pie data={pieData} dataKey={vKey} nameKey={xKey} outerRadius={85} innerRadius={30}
            label={renderLabel} labelLine>
            {pieData.map((_, i) => <Cell key={i} fill={PALETTE[i % PALETTE.length]} />)}
          </Pie>
          {TIP}<Legend />
        </PieChart>
      </ResponsiveContainer>
    );
  }

  // ── Bar ───────────────────────────────────────────────────────────────────
  if (chartType === "bar") {
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <BarChart data={data} margin={{ top: 20, right: 10, left: 0, bottom: 0 }}>
          {GRID}{XA}{YA}{TIP}
          {yKeys.map((k, i) => (
            <Bar key={k} dataKey={k} fill={PALETTE[i % PALETTE.length]} radius={[4,4,0,0]}>
              {showLabels && <LabelList dataKey={k} position="top" style={LABEL_STYLE} formatter={fmt} />}
            </Bar>
          ))}
        </BarChart>
      </ResponsiveContainer>
    );
  }

  // ── Stacked Bar ───────────────────────────────────────────────────────────
  if (chartType === "stackedbar") {
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <BarChart data={data} margin={{ top: 20, right: 10, left: 0, bottom: 0 }}>
          {GRID}{XA}{YA}{TIP}<Legend />
          {yKeys.map((k, i) => (
            <Bar key={k} dataKey={k} fill={PALETTE[i % PALETTE.length]} stackId="a"
              radius={i === yKeys.length-1 ? [4,4,0,0] : [0,0,0,0]}>
              {showLabels && <LabelList dataKey={k} position="center" style={{ ...LABEL_STYLE, fill: "#fff" }} formatter={fmt} />}
            </Bar>
          ))}
        </BarChart>
      </ResponsiveContainer>
    );
  }

  // ── Scatter ───────────────────────────────────────────────────────────────
  if (chartType === "scatter") {
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <ScatterChart margin={{ top: 20, right: 10, left: 0, bottom: 0 }}>
          {GRID}{XA}<YAxis dataKey={yKeys[0]} stroke="#8b93a7" fontSize={11} width={42} />{TIP}
          <Scatter data={data} fill={PALETTE[0]}>
            {showLabels && <LabelList dataKey={xKey} position="top" style={LABEL_STYLE} />}
          </Scatter>
        </ScatterChart>
      </ResponsiveContainer>
    );
  }

  // ── Bubble ────────────────────────────────────────────────────────────────
  if (chartType === "bubble") {
    const zKey = result.columns[2] ?? yKeys[0];
    const bubbleData = data.map(r => ({
      x: parseFloat(String(r[xKey] ?? 0)) || 0,
      y: parseFloat(String(r[yKeys[0]] ?? 0)) || 0,
      z: parseFloat(String(r[zKey] ?? 1)) || 1,
      name: String(r[xKey] ?? ""),
    }));
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <ScatterChart margin={{ top: 20, right: 20, bottom: 20, left: 20 }}>
          {GRID}
          <XAxis type="number" dataKey="x" name={xKey} stroke="#8b93a7" fontSize={11} tickFormatter={v => fmt(v) ?? v} />
          <YAxis type="number" dataKey="y" name={yKeys[0]} stroke="#8b93a7" fontSize={11} width={42} tickFormatter={v => fmt(v) ?? v} />
          <ZAxis type="number" dataKey="z" range={[50, 500]} name={zKey} />
          <Tooltip contentStyle={TOOLTIP_STYLE} cursor={{ strokeDasharray: "3 3" }}
            formatter={(v: unknown, name: string) => [fmt(v) ?? v, name]} />
          <Scatter data={bubbleData} fill={PALETTE[0]} fillOpacity={0.75}>
            {showLabels && <LabelList dataKey="name" position="top" style={LABEL_STYLE} />}
          </Scatter>
        </ScatterChart>
      </ResponsiveContainer>
    );
  }

  // ── Radar ─────────────────────────────────────────────────────────────────
  if (chartType === "radar") {
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <RadarChart data={data} margin={{ top: 10, right: 30, bottom: 10, left: 30 }}>
          <PolarGrid stroke="rgba(255,255,255,0.1)" />
          <PolarAngleAxis dataKey={xKey} stroke="#8b93a7" fontSize={11}
            tick={({ payload, x, y, textAnchor }: any) => (
              <text x={x} y={y} textAnchor={textAnchor} fill="#8b93a7" fontSize={11}>{payload.value}</text>
            )} />
          <PolarRadiusAxis stroke="#8b93a7" fontSize={9} tickFormatter={v => fmt(v) ?? String(v)} />
          {TIP}<Legend />
          {yKeys.map((k, i) => (
            <Radar key={k} name={k} dataKey={k} stroke={PALETTE[i % PALETTE.length]}
              fill={PALETTE[i % PALETTE.length]} fillOpacity={0.25}
              label={showLabels ? { fontSize: 9, fill: PALETTE[i % PALETTE.length], formatter: fmt } : false} />
          ))}
        </RadarChart>
      </ResponsiveContainer>
    );
  }

  // ── Funnel ────────────────────────────────────────────────────────────────
  if (chartType === "funnel") {
    const funnelData = data.map((r, i) => ({
      value: parseFloat(String(r[yKeys[0]] ?? 0)) || 0,
      name: String(r[xKey] ?? i),
      fill: PALETTE[i % PALETTE.length],
    }));
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <FunnelChart margin={{ top: 10, right: 10, bottom: 10, left: 10 }}>
          <Tooltip contentStyle={TOOLTIP_STYLE} formatter={(v: unknown) => [fmt(v) ?? v, ""]} />
          <Funnel dataKey="value" data={funnelData} isAnimationActive>
            <LabelList position="center" fill="#fff" fontSize={12} dataKey="name" />
            <LabelList position="right" fill="#8b93a7" fontSize={11} dataKey="value" formatter={fmt} />
          </Funnel>
        </FunnelChart>
      </ResponsiveContainer>
    );
  }

  // ── Waterfall ─────────────────────────────────────────────────────────────
  if (chartType === "waterfall") {
    let cum = 0;
    const wfData = data.map(r => {
      const val = parseFloat(String(r[yKeys[0]] ?? 0)) || 0;
      const base = cum;
      cum += val;
      return { ...r, _base: val >= 0 ? base : base + val, _val: Math.abs(val), _pos: val >= 0, _label: val };
    });
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <BarChart data={wfData} margin={{ top: 24, right: 10, left: 0, bottom: 0 }}>
          {GRID}{XA}{YA}{TIP}
          <Bar dataKey="_base" stackId="w" fill="transparent" />
          <Bar dataKey="_val" stackId="w" radius={[4,4,0,0]}>
            {wfData.map((d, i) => <Cell key={i} fill={d._pos ? PALETTE[0] : PALETTE[4]} />)}
            <LabelList dataKey="_label" position="top" style={LABEL_STYLE} formatter={fmt} />
          </Bar>
        </BarChart>
      </ResponsiveContainer>
    );
  }

  // ── Combo ─────────────────────────────────────────────────────────────────
  if (chartType === "combo") {
    const mid = Math.ceil(yKeys.length / 2);
    const barKeys = yKeys.slice(0, mid);
    const lineKeys = yKeys.slice(mid);
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <ComposedChart data={data} margin={{ top: 24, right: 10, left: 0, bottom: 0 }}>
          {GRID}{XA}{YA}{TIP}<Legend />
          {barKeys.map((k, i) => (
            <Bar key={k} dataKey={k} fill={PALETTE[i % PALETTE.length]} radius={[4,4,0,0]}>
              {showLabels && <LabelList dataKey={k} position="top" style={LABEL_STYLE} formatter={fmt} />}
            </Bar>
          ))}
          {lineKeys.map((k, i) => (
            <Line key={k} type="monotone" dataKey={k} stroke={PALETTE[(i+mid) % PALETTE.length]}
              strokeWidth={2} dot={{ r: 3, fill: PALETTE[(i+mid) % PALETTE.length] }}
              label={showLabels ? { position: "top", style: LABEL_STYLE, formatter: fmt } : false} />
          ))}
        </ComposedChart>
      </ResponsiveContainer>
    );
  }

  // ── Treemap ───────────────────────────────────────────────────────────────
  if (chartType === "treemap") {
    const tmData = data.map((r, i) => ({
      name: String(r[xKey] ?? i),
      size: parseFloat(String(r[yKeys[0]] ?? 0)) || 1,
      fill: PALETTE[i % PALETTE.length],
    }));
    const CustomContent = ({ x, y, width, height, name, value }: any) => {
      if (width < 30 || height < 20) return null;
      return (
        <g>
          <rect x={x} y={y} width={width} height={height} style={{ fill: PALETTE[name?.charCodeAt(0) % PALETTE.length ?? 0], stroke: "#0d1117", strokeWidth: 2 }} rx={4} />
          {height > 30 && <text x={x+width/2} y={y+height/2-6} textAnchor="middle" fill="#fff" fontSize={11} fontWeight={600}>{name}</text>}
          {height > 44 && <text x={x+width/2} y={y+height/2+10} textAnchor="middle" fill="rgba(255,255,255,0.7)" fontSize={10}>{fmt(value)}</text>}
        </g>
      );
    };
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <Treemap data={tmData} dataKey="size" aspectRatio={4/3} content={<CustomContent />}>
          <Tooltip contentStyle={TOOLTIP_STYLE} formatter={(v: unknown) => [fmt(v) ?? v, ""]} />
        </Treemap>
      </ResponsiveContainer>
    );
  }

  // ── Heatmap (CSS grid) ────────────────────────────────────────────────────
  if (chartType === "heatmap") {
    const vals = data.map(r => parseFloat(String(r[yKeys[0]] ?? 0)) || 0);
    const mn = Math.min(...vals), mx = Math.max(...vals);
    const pct = (v: number) => mx === mn ? 0.5 : (v - mn) / (mx - mn);
    const color = (p: number) => `hsl(${Math.round(220 - p * 200)}, 80%, ${Math.round(25 + p * 40)}%)`;
    return wrap(
      <div className="overflow-auto p-2">
        <div className="grid gap-1" style={{ gridTemplateColumns: `repeat(${Math.min(data.length, 15)}, minmax(0,1fr))` }}>
          {data.map((r, i) => {
            const v = parseFloat(String(r[yKeys[0]] ?? 0)) || 0;
            const p = pct(v);
            return (
              <div key={i} title={`${r[xKey]}: ${v}`}
                className="rounded flex flex-col items-center justify-center p-1 cursor-default"
                style={{ background: color(p), minHeight: 48 }}>
                <div className="text-[9px] text-white/70 truncate w-full text-center">{String(r[xKey] ?? "")}</div>
                <div className="text-xs font-bold text-white">{fmt(v)}</div>
              </div>
            );
          })}
        </div>
        <div className="flex items-center gap-2 mt-2 px-1">
          <span className="text-xs text-slate-500">{fmt(mn)}</span>
          <div className="flex-1 h-2 rounded" style={{ background: "linear-gradient(to right, hsl(220,80%,25%), hsl(20,80%,65%))" }} />
          <span className="text-xs text-slate-500">{fmt(mx)}</span>
        </div>
      </div>
    );
  }

  // ── Boxplot (simplified: min/q1/median/q3/max) ────────────────────────────
  if (chartType === "boxplot") {
    const grouped: Record<string, number[]> = {};
    data.forEach(r => {
      const g = String(r[xKey] ?? "");
      const v = parseFloat(String(r[yKeys[0]] ?? ""));
      if (!isNaN(v)) { grouped[g] = grouped[g] ?? []; grouped[g].push(v); }
    });
    const boxes = Object.entries(grouped).map(([name, vals]) => {
      vals.sort((a,b) => a-b);
      const q = (p: number) => { const i = p*(vals.length-1); const f=Math.floor(i); return vals[f]+(vals[f+1]??vals[f]-vals[f])*(i-f); };
      return { name, min: vals[0], q1: q(0.25), median: q(0.5), q3: q(0.75), max: vals[vals.length-1] };
    });
    if (!boxes.length) return wrap(<p className="text-sm text-slate-500">Not enough data for boxplot.</p>);
    const allVals = boxes.flatMap(b => [b.min, b.max]);
    const mn = Math.min(...allVals), mx = Math.max(...allVals), range = mx - mn || 1;
    const pct = (v: number) => ((v - mn) / range) * 100;
    return wrap(
      <div className="space-y-3 p-3 overflow-auto" style={{ maxHeight: H }}>
        {boxes.map((b, i) => (
          <div key={b.name} className="flex items-center gap-3">
            <div className="w-20 text-xs text-slate-400 truncate shrink-0 text-right">{b.name}</div>
            <div className="relative flex-1 h-8">
              <div className="absolute inset-y-0 flex items-center w-full">
                <div className="h-px w-full bg-white/10" />
              </div>
              {/* whiskers */}
              <div className="absolute h-3 w-px bg-slate-400" style={{ left: `${pct(b.min)}%`, top: "50%", transform: "translateY(-50%)" }} />
              <div className="absolute h-3 w-px bg-slate-400" style={{ left: `${pct(b.max)}%`, top: "50%", transform: "translateY(-50%)" }} />
              <div className="absolute h-px bg-slate-400" style={{ left: `${pct(b.min)}%`, width: `${pct(b.q1)-pct(b.min)}%`, top: "50%" }} />
              <div className="absolute h-px bg-slate-400" style={{ left: `${pct(b.q3)}%`, width: `${pct(b.max)-pct(b.q3)}%`, top: "50%" }} />
              {/* box */}
              <div className="absolute rounded border border-white/30 h-5"
                style={{ left: `${pct(b.q1)}%`, width: `${pct(b.q3)-pct(b.q1)}%`, top: "50%", transform: "translateY(-50%)", background: PALETTE[i % PALETTE.length] + "33" }}>
                <div className="absolute h-full w-px bg-white" style={{ left: `${((b.median-b.q1)/(b.q3-b.q1||1))*100}%` }} />
              </div>
            </div>
            <div className="text-xs text-slate-500 shrink-0 w-28 hidden lg:block">
              {fmt(b.min)}·{fmt(b.median)}·{fmt(b.max)}
            </div>
          </div>
        ))}
      </div>
    );
  }

  // ── Forecast ──────────────────────────────────────────────────────────────
  if (chartType === "forecast") {
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <LineChart data={data} margin={{ top: 24, right: 10, left: 0, bottom: 0 }}>
          {GRID}{XA}{YA}{TIP}
          {yKeys.map((k, i) => {
            const isFc = k.toLowerCase().includes("forecast") || k.toLowerCase().includes("predicted");
            return (
              <Line key={k} type="monotone" dataKey={k} stroke={PALETTE[i % PALETTE.length]}
                strokeWidth={2} strokeDasharray={isFc ? "6 4" : "0"}
                dot={{ r: 3, fill: PALETTE[i % PALETTE.length] }}
                label={showLabels ? { position: "top", style: LABEL_STYLE, formatter: fmt } : false} />
            );
          })}
        </LineChart>
      </ResponsiveContainer>
    );
  }

  // ── Area ──────────────────────────────────────────────────────────────────
  if (chartType === "area") {
    return wrap(
      <ResponsiveContainer width="100%" height={H}>
        <ComposedChart data={data} margin={{ top: 24, right: 10, left: 0, bottom: 0 }}>
          {GRID}{XA}{YA}{TIP}
          {yKeys.map((k, i) => (
            <Area key={k} type="monotone" dataKey={k} stroke={PALETTE[i % PALETTE.length]}
              fill={PALETTE[i % PALETTE.length]} fillOpacity={0.15} strokeWidth={2}
              dot={showLabels ? { r: 3 } : false}
              label={showLabels ? { position: "top", style: LABEL_STYLE, formatter: fmt } : false} />
          ))}
        </ComposedChart>
      </ResponsiveContainer>
    );
  }

  // ── Default: Line ─────────────────────────────────────────────────────────
  return wrap(
    <ResponsiveContainer width="100%" height={H}>
      <LineChart data={data} margin={{ top: 24, right: 10, left: 0, bottom: 0 }}>
        {GRID}{XA}{YA}{TIP}
        {yKeys.map((k, i) => (
          <Line key={k} type="monotone" dataKey={k} stroke={PALETTE[i % PALETTE.length]}
            strokeWidth={2} dot={{ r: 3, fill: PALETTE[i % PALETTE.length] }}
            label={showLabels ? { position: "top", style: LABEL_STYLE, formatter: fmt } : false} />
        ))}
      </LineChart>
    </ResponsiveContainer>
  );
}
