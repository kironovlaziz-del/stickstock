# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=production
PORT=8080

# --- Supabase (create a free project at https://supabase.com) ---

# Settings → Database → Connection string → URI (use the "Session pooler"
# or direct connection string; either works with pgx). Use the service_role
# connection, not the anon one — the Go backend needs to bypass Row Level
# Security since it does its own ownership checks in code.
DATABASE_URL=xktnopljkdhmpliild.supabase.co

# Settings → API → JWT Secret. This is what verifies the JWTs Supabase
# Auth issues when someone signs in on the frontend — it is NOT something
# you generate yourself.
JWT_SECRET=Lm+t5HbmADwUMjuc2iRYqgYFD9hEuTc2R8JzQ72vZIChrbGz0IVy8hZSZFEwZq3X1vNEcS35id8N8glTRmia0w==

# These two aren't used by the Go backend directly, but the frontend
# (supabase-js) needs them — keeping them here so all deployment config
# lives in one place. Settings → API → Project URL / anon public key.
SUPABASE_URL=https://xxxktnopljkdhmpliild.supabase.co/rest/v1/
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh4eGt0bm9wbGprZGhtcGxpaWxkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY4MjU5NzYsImV4cCI6MjEwMjQwMTk3Nn0.rOp-FNKnspV5BTyhwTzmwSZ5yTf12bygBHB14Ew31eY

DEFAULT_LOCALE=ru
ALLOWED_ORIGINS=https://stickstock.lol

# analytics-service (Python) needs no secrets — Polars/DuckDB/statsmodels/
# PyOD all run locally, no external API calls.

# --- cmd/worker delivery channels (both optional — leave blank to skip) ---

# SMTP for emailed scheduled reports. Any provider's SMTP works (Gmail,
# SES, Mailgun, your own mail server, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram Bot API token for scheduled reports delivered to a chat.
# Create a bot via @BotFather, paste its token here.
TELEGRAM_BOT_TOKEN=

# --- OSINT ---

# haveibeenpwned.com API key, for the "breach" lookup type only (WHOIS
# and DNS lookups need no key). Get one at
# https://haveibeenpwned.com/API/Key — leave blank to disable breach
# checks; whois/dns lookups work regardless.
HIBP_API_KEY=
